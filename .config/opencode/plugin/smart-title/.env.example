# Optional: Custom proxy URL (without /v1 suffix)
# Default: http://localhost:4141
# COPILOT_API_URL=http://localhost:4141

# Optional: Update title every N user messages
# Default: 1 (update on every user message)
# TITLE_UPDATE_THRESHOLD=2

# Optional: Enable debug logging to /tmp/opencode-smart-title-debug.log
# Default: false
# DEBUG=true
