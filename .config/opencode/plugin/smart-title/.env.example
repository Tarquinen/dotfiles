# AI Provider: openai, gemini, anthropic, or copilot
AI_PROVIDER=copilot

# Model name (see README for options per provider)
AI_MODEL=gpt-5-mini

# Optional: Update title every N user messages (default: 1)
# TITLE_UPDATE_THRESHOLD=2

# Optional: Custom copilot proxy URL (default: http://localhost:4141)
# COPILOT_API_URL=http://localhost:4141

# Optional: Enable debug logging (default: false)
# DEBUG=true

# Note: API keys should be set as system environment variables:
# - OPENAI_API_KEY (for OpenAI)
# - GOOGLE_GENERATIVE_AI_API_KEY (for Gemini)
# - ANTHROPIC_API_KEY (for Anthropic)
