{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "permission": {
        "bash": {
            "*": "allow",
            "* dev": "deny",
            "sudo *": "deny"
        }
    },
    "agent": {
        "build": {
            "model": "github-copilot/claude-sonnet-4.5"
        },
        "plan": {
            "model": "github-copilot/gpt-4.1"
        },
        "general": {
            "model": "github-copilot/claude-sonnet-4.5"
        }
    },
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app/"
        }
    },
    "theme": "one-dark",
    "keybinds": {
        "input_newline": "alt+enter"
    },
    "lsp": {
        "python": {
            "disabled": true
        }
    },
    "experimental": {
        "batch_tool": true
    },
    "small_model": "opencode/big-pickle",
    "plugin": [
        "opencode-anthropic-auth@0.0.2",
        "opencode-copilot-auth@0.0.5",
        "./plugin/copilot-force-agent-header",
        "opencode-gemini-auth",
        "@openhax/codex",
        "@tarquinen/opencode-dcp@0.3.3",
        "@tarquinen/opencode-smart-title@0.1.4",
        // "./plugin/opencode-dynamic-context-pruning",
        // "./plugin/smart-title",
    ]
}
